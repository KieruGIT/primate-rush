# Godot 4 rebuildable cache and per-machine settings
.godot/
.import/
export.cfg
export_presets.cfg
*.translation

# Build output
build/
*.apk
*.aab
*.keystore
*.jks

# Secrets. The Test Store key lives here, never in source.
secrets.cfg
.env

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Tiny Swords (Pixel Frog) forbids redistribution, and this repo is public.
# Nothing references it; it stays out of git.
assets/freegameassets/

# Files moved out by tools/debloat.gd. Kept on disk in case something
# turns out to need them; never committed.
_unused/

# Python bytecode cache from the art authoring tools in tools/art/
__pycache__/
*.pyc

# Screenshots and logs from the dev probes in tools/ (regenerated on every run)
output/qa/

# Local dev output: perf logs, probe screenshots, source zips, icon drafts.
# Kept on disk, never committed (a source zip could carry secrets.cfg).
output/

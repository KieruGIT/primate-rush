; Engine configuration file.
; Monkey - hackathon build.
;
; Renderer is locked to Compatibility (OpenGL 3). The dev GPU cannot run
; Mobile or Forward+, and Compatibility is also the widest-support option
; on low-end Android hardware. Do not "upgrade" this.

config_version=5

[application]

config/name="Monkey"
config/description="Multiplayer party game about monkeys. Nobody dies, you just get knocked around."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/autoload/GameConfig.gd"
GameInput="*res://scripts/autoload/GameInput.gd"
Net="*res://scripts/autoload/Net.gd"
Discovery="*res://scripts/autoload/Discovery.gd"
Purchases="*res://scripts/autoload/Purchases.gd"
Profile="*res://scripts/autoload/Profile.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

